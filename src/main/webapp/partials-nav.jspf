<%@ page import="com.recipe.model.User" %><% User navUser=(User)session.getAttribute("user"); %>
<header class="nav"><a class="brand" href="${pageContext.request.contextPath}/recipes">Recipe Haven</a><nav class="nav-links"><a href="${pageContext.request.contextPath}/recipes">Discover</a><% if(navUser!=null){ %><a href="${pageContext.request.contextPath}/recipe-create.jsp">Share a recipe</a><a href="${pageContext.request.contextPath}/my-recipes">My recipes</a><% if(navUser.isAdmin()){ %><a href="${pageContext.request.contextPath}/admin">Admin</a><% } %><span class="small">Hi, <%= navUser.getName().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") %></span><form class="inline" method="post" action="${pageContext.request.contextPath}/logout"><button class="secondary" type="submit">Log out</button></form><% }else{ %><a href="${pageContext.request.contextPath}/login">Log in</a><a class="btn" href="${pageContext.request.contextPath}/register">Join free</a><% } %></nav></header>
