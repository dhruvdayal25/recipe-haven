<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.recipe.model.Recipe" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin review</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials-nav.jspf" %><main class="container"><h1>Recipe moderation</h1><p class="muted">Review submitted recipes before they appear publicly.</p><div class="grid"><% List<Recipe> list=(List<Recipe>)request.getAttribute("recipes");if(list!=null&&!list.isEmpty()){for(Recipe r:list){%><article class="card card-body"><span class="status">PENDING</span><h3><%=r.getTitle().replace("&","&amp;").replace("<","&lt;")%></h3><p class="muted">By <%=r.getAuthor().replace("<","&lt;")%></p><p><%=r.getDescription()==null?"":r.getDescription().replace("<","&lt;")%></p><h4>Ingredients</h4><div class="content-block"><%=r.getIngredients().replace("<","&lt;")%></div><div class="actions"><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="id" value="<%=r.getRecipeId()%>"><input type="hidden" name="status" value="APPROVED"><button>Approve</button></form><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="id" value="<%=r.getRecipeId()%>"><input type="hidden" name="status" value="REJECTED"><button class="danger">Reject</button></form></div></article><%}}else{%><p>No pending recipes.</p><%}%></div></main></body></html>
