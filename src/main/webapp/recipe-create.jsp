<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.recipe.model.User" %><% if(session.getAttribute("user")==null){response.sendRedirect(request.getContextPath()+"/login");return;} %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Share recipe | Recipe Haven</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials-nav.jspf" %><main class="container"><section class="form-card"><span class="eyebrow">Pass it around</span><h1>Share a recipe</h1><p class="muted">New recipes are reviewed by an admin before appearing publicly.</p><form method="post" action="${pageContext.request.contextPath}/recipe/create"><label>Recipe title</label><input name="title" maxlength="160" required><label>Short description</label><textarea name="description" maxlength="500"></textarea><label>Ingredients</label><textarea name="ingredients" required placeholder="One ingredient per line"></textarea><label>Instructions</label><textarea name="instructions" required placeholder="Describe each step"></textarea><label>Image URL (optional)</label><input type="url" name="imageUrl" maxlength="1000" placeholder="https://..."><p><button>Submit recipe</button></p></form></section></main></body></html>
