<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.recipe.model.*,com.recipe.dao.CommunityDAO,java.util.*" %><%! private String esc(String s){return s==null?"":s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");} %><% Recipe recipe=(Recipe)request.getAttribute("recipe");User current=(User)session.getAttribute("user"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=esc(recipe.getTitle())%> | Recipe Haven</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials-nav.jspf" %><main class="container detail"><a href="${pageContext.request.contextPath}/recipes">← All recipes</a><% if(recipe.getImageUrl()!=null&&!recipe.getImageUrl().isBlank()){ %><img class="recipe-image" style="height:300px;border-radius:16px;margin-top:20px" src="<%=esc(recipe.getImageUrl())%>" alt="Recipe image"><% } %><h1><%=esc(recipe.getTitle())%></h1><p class="muted">Shared by <%=esc(recipe.getAuthor())%></p><p><%=esc(recipe.getDescription())%></p><h2>Ingredients</h2><div class="content-block"><%=esc(recipe.getIngredients())%></div><h2>Instructions</h2><div class="content-block"><%=esc(recipe.getInstructions())%></div><% try { double avg=new CommunityDAO().averageRating(recipe.getRecipeId()); %><h2>Community rating</h2><p>★ <%=String.format(java.util.Locale.US,"%.1f",avg)%> / 5</p><% }catch(Exception ignored){} %>
<% if(current!=null){ %><section class="card card-body"><h2>Rate this recipe</h2><form method="post" action="${pageContext.request.contextPath}/rating"><input type="hidden" name="recipeId" value="<%=recipe.getRecipeId()%>"><label>Rating</label><select name="rating"><option value="5">5 - Excellent</option><option value="4">4 - Very good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Poor</option></select><p><button>Submit rating</button></p></form><h2>Leave a comment</h2><form method="post" action="${pageContext.request.contextPath}/comment"><input type="hidden" name="recipeId" value="<%=recipe.getRecipeId()%>"><textarea name="comment" required maxlength="1000"></textarea><p><button>Post comment</button></p></form></section><% }else{ %><p><a href="${pageContext.request.contextPath}/login">Log in</a> to rate or comment.</p><% } %>
<h2>Comments</h2><% try { for(Comment c:new CommunityDAO().comments(recipe.getRecipeId())){ %><article class="card card-body"><strong><%=esc(c.getAuthor())%></strong><p><%=esc(c.getCommentText())%></p><span class="muted small"><%=c.getCreatedAt()%></span></article><% } }catch(Exception ignored){} %></main></body></html>
