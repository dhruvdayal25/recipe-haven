<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.recipe.model.Recipe" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Discover recipes | Recipe Haven</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials-nav.jspf" %><main class="container"><section class="hero"><span class="eyebrow">Good food brings us together</span><h1>Find your next<br>favorite recipe.</h1><p class="muted">Discover home-cooked inspiration from our community.</p></section><form class="toolbar" method="get" action="${pageContext.request.contextPath}/recipes"><div class="search"><input name="q" placeholder="Search recipes..." value="<%= request.getParameter("q")==null?"":request.getParameter("q").replace("&","&amp;").replace("\"","&quot;").replace("<","&lt;") %>"><button>Search</button></div></form>
<div class="grid"><% List<Recipe> recipes=(List<Recipe>)request.getAttribute("recipes"); if(recipes!=null&&!recipes.isEmpty()){for(Recipe r:recipes){String title=r.getTitle().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;");String desc=r.getDescription()==null?"":r.getDescription().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;");%><article class="card"><% if(r.getImageUrl()!=null&&!r.getImageUrl().isBlank()){ %><img class="recipe-image" src="<%= r.getImageUrl().replace("\"","&quot;").replace("<","") %>" alt="Recipe image" loading="lazy"><% }else{ %><div class="placeholder">🥗</div><% } %><div class="card-body"><h3><a href="${pageContext.request.contextPath}/recipe?id=<%=r.getRecipeId()%>"><%=title%></a></h3><p class="muted"><%=desc%></p><p class="small">By <%=r.getAuthor().replace("&","&amp;").replace("<","&lt;")%></p><a class="btn secondary" href="${pageContext.request.contextPath}/recipe?id=<%=r.getRecipeId()%>">View recipe</a></div></article><%}}else{%><p class="muted">No approved recipes yet. Sign in and share the first one!</p><%}%></div></main><footer class="footer">Made for food lovers · Recipe Haven</footer><script src="${pageContext.request.contextPath}/js/main.js"></script></body></html>
