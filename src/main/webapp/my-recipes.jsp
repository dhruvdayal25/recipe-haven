<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.recipe.model.Recipe" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My recipes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials-nav.jspf" %><main class="container"><h1>My recipes</h1><p><a class="btn" href="${pageContext.request.contextPath}/recipe-create.jsp">+ Share a recipe</a></p><div class="grid"><% List<Recipe> list=(List<Recipe>)request.getAttribute("recipes");if(list!=null)for(Recipe r:list){%><article class="card card-body"><span class="status"><%=r.getStatus()%></span><h3><%=r.getTitle().replace("&","&amp;").replace("<","&lt;")%></h3><p class="muted"><%=r.getDescription()==null?"":r.getDescription().replace("<","&lt;")%></p><div class="actions"><%if("APPROVED".equals(r.getStatus())){%><a class="btn secondary" href="${pageContext.request.contextPath}/recipe?id=<%=r.getRecipeId()%>">View</a><%}%><form method="post" action="${pageContext.request.contextPath}/recipe/delete" data-confirm="Delete this recipe?"><input type="hidden" name="id" value="<%=r.getRecipeId()%>"><button class="danger">Delete</button></form></div></article><%}%></div></main><script src="${pageContext.request.contextPath}/js/main.js"></script></body></html>
